+  private toggleLandscapeFullscreen(): void {
+    if (this.landscapeChanging) {
+      return;
+    }
+    if (this.landscapeFullscreen) {
+      this.exitLandscapeFullscreen();
+      return;
+    }
+    if (!this.landscapeButtonVisible || !this.alive) {
+      return;
+    }
+    this.queueLandscapeChange((): Promise<void> => this.enterLandscapeFullscreen());
+  }
+
+  private async enterLandscapeFullscreen(): Promise<void> {
+    const context = this.getUIContext().getHostContext();
+    if (!context) {
+      return;
+    }
+    try {
+      const main = await window.getLastWindow(context);
+      if (!this.alive || !this.landscapeButtonVisible) {
+        return;
+      }
+      if (main.getWindowStatus() !== window.WindowStatusType.FULL_SCREEN) {
+        this.showMessage('请先退出分屏或悬浮窗，再使用横屏全屏');
+        return;
+      }
+      this.landscapeRestore = {
+        mainWindow: main,
+        orientation: main.getPreferredOrientation(),
+        statusVisible: main.getWindowAvoidArea(window.AvoidAreaType.TYPE_SYSTEM).topRect.height > 0,
+        collapsed: this.fullscreen,
+      };
+      this.landscapeFullscreen = true;
+      this.setFullscreen(true);
+      await main.setPreferredOrientation(window.Orientation.USER_ROTATION_LANDSCAPE);
+      if (this.alive) {
+        await main.setSpecificSystemBarEnabled('status', false).catch((): void => {});
+      }
+    } catch (_error) {
+      await this.restoreLandscapeWindow();
+      if (this.alive) {
+        this.showMessage('当前窗口无法进入横屏全屏');
+      }
+    }
+  }
+
+  private exitLandscapeFullscreen(): void {
+    if (!this.landscapeRestore && !this.landscapeChanging) {
+      return;
+    }
+    this.queueLandscapeChange((): Promise<void> => this.restoreLandscapeWindow());
+  }
+
+  private queueLandscapeChange(change: () => Promise<void>): void {
+    this.landscapeChanging = true;
+    const work = this.landscapeWork.then(change).catch((): void => {
+      hilog.warn(0x00F1, 'HongguoPlayer', 'Landscape orientation transition failed');
+    });
+    this.landscapeWork = work;
+    work.then((): void => {
+      if (this.landscapeWork === work) {
+        this.landscapeChanging = false;
+      }
+    });
+  }
+
+  private async restoreLandscapeWindow(): Promise<void> {
+    const saved = this.landscapeRestore;
+    if (!saved) {
+      return;
+    }
+    this.landscapeRestore = undefined;
+    this.landscapeFullscreen = false;
+    if (this.alive) {
+      this.setFullscreen(saved.collapsed);
+    }
+    await saved.mainWindow.setPreferredOrientation(saved.orientation).catch((): void => {});
+    await saved.mainWindow.setSpecificSystemBarEnabled('status', saved.statusVisible).catch((): void => {});
+  }
