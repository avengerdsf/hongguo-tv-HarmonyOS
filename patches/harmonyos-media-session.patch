diff --git a/harmony/entry/src/main/ets/model/PlaybackMediaSession.ets b/harmony/entry/src/main/ets/model/PlaybackMediaSession.ets
new file mode 100644
--- /dev/null
+++ b/harmony/entry/src/main/ets/model/PlaybackMediaSession.ets
@@ -0,0 +1,223 @@
+import { common, WantAgent, wantAgent } from '@kit.AbilityKit';
+import { avSession } from '@kit.AVSessionKit';
+import { backgroundTaskManager } from '@kit.BackgroundTasksKit';
+import { BusinessError, deviceInfo } from '@kit.BasicServicesKit';
+import { hilog } from '@kit.PerformanceAnalysisKit';
+
+const DOMAIN: number = 0x00F1;
+const TAG: string = 'HongguoMediaSession';
+
+export interface PlaybackMediaCommands {
+  play: () => void;
+  pause: () => void;
+  next: () => void;
+  previous: () => void;
+  seek: (milliseconds: number) => void;
+  backgroundInterrupted: () => void;
+}
+
+export interface PlaybackMediaUpdate {
+  metadata: avSession.AVMetadata;
+  state: avSession.AVPlaybackState;
+  allowBackground: boolean;
+  keepBackgroundTask: boolean;
+}
+
+let currentSession: PlaybackMediaSession | undefined;
+let platformWork: Promise<void> = Promise.resolve();
+
+function report(operation: string, error: BusinessError): void {
+  hilog.warn(DOMAIN, TAG, '%{public}s failed, code=%{public}d', operation, error.code ?? 0);
+}
+
+export class PlaybackMediaSession {
+  private readonly context: common.UIAbilityContext;
+  private readonly commands: PlaybackMediaCommands;
+  private session?: avSession.AVSession;
+  private launch?: WantAgent;
+  private pending?: PlaybackMediaUpdate;
+  private queued: boolean = false;
+  private closed: boolean = false;
+  private taskActive: boolean = false;
+  private taskRequested: boolean = false;
+  private taskId?: number;
+  private metadataKey: string = '';
+  private backgroundAllowed?: boolean;
+  private listeningForCancellation: boolean = false;
+
+  private onTaskCancelled = (info: backgroundTaskManager.ContinuousTaskCancelInfo): void => {
+    if (this.taskActive && (this.taskId === undefined || this.taskId === info.id)) {
+      this.taskActive = false;
+      this.taskId = undefined;
+      this.commands.backgroundInterrupted();
+    }
+  };
+
+  constructor(context: common.UIAbilityContext, commands: PlaybackMediaCommands) {
+    currentSession?.close();
+    currentSession = this;
+    this.context = context;
+    this.commands = commands;
+  }
+
+  get backgroundReady(): boolean {
+    return this.taskActive;
+  }
+
+  publish(update: PlaybackMediaUpdate): void {
+    if (this.closed) {
+      return;
+    }
+    this.pending = update;
+    if (this.queued) {
+      return;
+    }
+    this.queued = true;
+    platformWork = platformWork.then(async (): Promise<void> => {
+      while (this.pending && !this.closed) {
+        const next = this.pending;
+        this.pending = undefined;
+        try {
+          await this.apply(next);
+        } catch (error) {
+          report('Media state', error as BusinessError);
+        }
+      }
+      this.queued = false;
+    });
+  }
+
+  private async ensureSession(): Promise<avSession.AVSession> {
+    if (this.session) {
+      return this.session;
+    }
+    const session = await avSession.createAVSession(this.context, 'HongguoPlayback', 'video');
+    this.session = session;
+    session.on('play', (): void => {
+      if (!this.closed) {
+        hilog.info(DOMAIN, TAG, 'Media center play');
+        this.commands.play();
+      }
+    });
+    session.on('pause', (): void => {
+      if (!this.closed) {
+        hilog.info(DOMAIN, TAG, 'Media center pause');
+        this.commands.pause();
+      }
+    });
+    session.on('playNext', (): void => { if (!this.closed) { this.commands.next(); } });
+    session.on('playPrevious', (): void => { if (!this.closed) { this.commands.previous(); } });
+    session.on('seek', (time: number): void => { if (!this.closed) { this.commands.seek(time); } });
+    try {
+      await session.activate();
+    } catch (error) {
+      this.session = undefined;
+      await session.destroy().catch((): void => {});
+      report('Media session activation', error as BusinessError);
+      throw new Error('Media session activation failed');
+    }
+    try {
+      this.launch = await wantAgent.getWantAgent({
+        wants: [{ bundleName: this.context.abilityInfo.bundleName, abilityName: this.context.abilityInfo.name }],
+        actionType: wantAgent.OperationType.START_ABILITY,
+        requestCode: 0,
+        wantAgentFlags: [wantAgent.WantAgentFlags.UPDATE_PRESENT_FLAG],
+      });
+      await session.setLaunchAbility(this.launch);
+    } catch (error) {
+      report('Media center launch action', error as BusinessError);
+    }
+    try {
+      backgroundTaskManager.on('continuousTaskCancel', this.onTaskCancelled);
+      this.listeningForCancellation = true;
+    } catch (error) {
+      report('Background task listener', error as BusinessError);
+    }
+    return session;
+  }
+
+  private async apply(update: PlaybackMediaUpdate): Promise<void> {
+    const session = await this.ensureSession();
+    if (this.closed) {
+      return;
+    }
+    const key = update.metadata.assetId + ':' + (update.metadata.duration ?? 0).toString();
+    if (key !== this.metadataKey) {
+      try {
+        await session.setAVMetadata(update.metadata);
+        this.metadataKey = key;
+      } catch (error) {
+        report('Media metadata', error as BusinessError);
+      }
+    }
+    if (deviceInfo.sdkApiVersion >= 24 && this.backgroundAllowed !== update.allowBackground) {
+      try {
+        await session.setBackgroundPlayMode(update.allowBackground ? avSession.BackgroundPlayMode.ENABLE_BACKGROUND_PLAY :
+          avSession.BackgroundPlayMode.DISABLE_BACKGROUND_PLAY);
+        this.backgroundAllowed = update.allowBackground;
+      } catch (error) {
+        report('Background play mode', error as BusinessError);
+      }
+    }
+    try {
+      await session.setAVPlaybackState(update.state);
+    } catch (error) {
+      report('AVSession playback state', error as BusinessError);
+    }
+    if (!update.keepBackgroundTask) {
+      this.taskRequested = false;
+      await this.stopBackgroundTask();
+    } else if (!this.closed && !this.taskRequested && this.launch) {
+      this.taskRequested = true;
+      try {
+        const task = await backgroundTaskManager.startBackgroundRunning(this.context, ['audioPlayback'], this.launch);
+        this.taskId = task.continuousTaskId;
+        this.taskActive = true;
+        hilog.info(DOMAIN, TAG, 'Audio playback background task started');
+      } catch (error) {
+        report('Background task start', error as BusinessError);
+      }
+    }
+  }
+
+  private async stopBackgroundTask(): Promise<void> {
+    if (!this.taskActive) {
+      return;
+    }
+    this.taskActive = false;
+    this.taskId = undefined;
+    try {
+      await backgroundTaskManager.stopBackgroundRunning(this.context);
+      hilog.info(DOMAIN, TAG, 'Audio playback background task stopped');
+    } catch (error) {
+      report('Background task stop', error as BusinessError);
+    }
+  }
+
+  close(): void {
+    if (this.closed) {
+      return;
+    }
+    this.closed = true;
+    this.pending = undefined;
+    if (currentSession === this) {
+      currentSession = undefined;
+    }
+    platformWork = platformWork.then(async (): Promise<void> => {
+      await this.stopBackgroundTask();
+      if (this.listeningForCancellation) {
+        try {
+          backgroundTaskManager.off('continuousTaskCancel', this.onTaskCancelled);
+        } catch (error) {
+          report('Background task listener cleanup', error as BusinessError);
+        }
+      }
+      try {
+        await this.session?.destroy();
+      } catch (error) {
+        report('Media session cleanup', error as BusinessError);
+      }
+      this.session = undefined;
+    });
+  }
+}
